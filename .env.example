# Copy this file to .env and set the values in your hosting provider's secret manager.
# Never commit .env or expose these values in frontend files.
PORT=5000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=your-verified-sender@example.com
